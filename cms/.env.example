# docker-compose.yml が同じディレクトリの .env を自動で読み込む。
# 使う変数だけ .env にコピーして値を埋める（全部揃っていなくても、
# worker/migrate/build サービスはデフォルト値で動く）。
#
#   cp .env.example .env

# --- ローカル開発用（worker / migrate / build サービス） ---
# 未設定でも "local-dev-token" が使われる。複数人で同じCloudflareアカウントを
# 共有するような場合以外は変更しなくてよい。
MCP_BEARER_TOKEN=local-dev-token

# publish_news から実際にGitHub Actionsを起動する動作までローカルで試したい場合のみ設定。
# 通常のnews CRUD確認だけなら空でよい。
GITHUB_TOKEN=
GITHUB_REPO=

# --- wrangler サービス（実Cloudflareアカウントへの一回限りの操作用） ---
# Cloudflareダッシュボード > My Profile > API Tokens で発行する
# （D1:Edit, Workers Scripts:Edit 権限があるカスタムトークン）。
# wrangler login はコンテナ内では使えないため、こちらのAPIトークン方式を使う。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
