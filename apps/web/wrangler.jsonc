{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcraft-web",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  // 注意: apps/web はD1に対して読み取り専用で使う（コード規約上、SELECT以外は
  // apps/api側からのみ発行する。マイグレーション適用もapps/api側のみが担う）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitcraft-cms",
      "database_id": "1bc667c7-51e3-4df3-b2db-37bff85f6804"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bitcraft-media"
    }
  ],
  // セミナー申込のPOSTをapps/apiへ委譲するためのService Binding。
  // ネットワークホップなしで呼び出せ、Custom Domain未接続の現段階でも
  // 同一アカウント内のWorker間で疎通できる。
  "services": [
    {
      "binding": "API",
      "service": "bitcraft-api"
    }
  ]
  // Phase 8 で Custom Domain (bitcraft.work) を接続する。
}
